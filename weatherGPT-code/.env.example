# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Groq LLM API Configuration
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-20b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# WeatherGPT Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# WeatherGPT Telemetry Backend URL
HEATZONE_BASE_URL=https://heatzone-backend.onrender.com

# Web3Forms API Key (Feedback Modal)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Meta WhatsApp Cloud API Integration
WHATSAPP_TOKEN=your_whatsapp_meta_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=weathergpt_verify_secret
