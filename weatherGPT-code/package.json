{
  "name": "weathergpt-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1",
    "dev": "python run.py",
    "frontend": "npm --prefix frontend run dev",
    "backend": "python -m backend.app.main",
    "build": "cd frontend && npm install && npm run build",
    "render-build": "./build.sh"
  }
}
