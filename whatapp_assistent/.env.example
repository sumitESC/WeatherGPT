# ============================================================
# WeatherGPT Professional WhatsApp Assistant - Environment File
# ============================================================

# 1. CORE AI & WEATHER API KEYS (REQUIRED)
# ------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-120b


# 2. META WHATSAPP CLOUD API CREDENTIALS (OPTION A - OFFICIAL)
# ------------------------------------------------------------
WHATSAPP_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=weathergpt_verify_secret
META_APP_SECRET=your_meta_app_secret_here


# 3. TWILIO WHATSAPP CREDENTIALS (OPTION B - ALTERNATIVE)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886


# 4. ADMIN DASHBOARD AUTHENTICATION CREDENTIALS
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=weathergpt_admin_pass
ADMIN_SECRET_KEY=weathergpt_jwt_secret_key_change_me
